generator client {
  provider = "prisma-client-js"
}

generator client_frontend {
  provider = "prisma-client-js"
  output   = "../../Front-end/node_modules/.prisma/client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../../Front-end/src/types/generated-zod"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String?
  name               String
  avatar             String?
  phone              String?          @unique
  address            String?
  googleId           String?          @unique
  githubId           String?          @unique
  isActive           Boolean          @default(false)
  status             Boolean          @default(true)
  codeId             String?
  codeExpired        DateTime?
  verifyToken        String?
  verifyTokenExpired DateTime?
  provider           String[]         @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  courses            Course[]
  courseReviews      CourseReview[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  orders             Order[]
  password_resets    Password_Resets?
  posts              Post[]
  postComments       PostComment[]
  refreshTokens      RefreshToken[]
  roles              UserRole[]
  wishlists          Wishlist[]

  @@index([status])
  @@index([isActive])
  @@index([email])
  @@index([phone])
  @@index([name])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Password_Resets {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  codeId      String
  codeExpired DateTime
  is_verified Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [email], references: [email])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  userRole     String?
  action       String
  entityName   String
  entityId     String?
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS")
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[] @relation("CourseToTag")
  posts       Post[]   @relation("PostToTag")
}

model Course {
  id                 String         @id @default(uuid())
  title              String
  slug               String         @unique
  description        String
  thumbnail          String?
  thumbnail_publicID String?
  courseType         CourseType     @default(FREE)
  level              Level          @default(BEGINNER)
  status             Boolean        @default(true)
  price              Decimal        @default(0) @db.Decimal(12, 2)
  discount           Decimal        @default(0) @db.Decimal(12, 2)
  instructorId       String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  averageRating      Float          @default(0)
  reviewCount        Int            @default(0)
  studentCount       Int            @default(0)
  instructor         User           @relation(fields: [instructorId], references: [id])
  reviews            CourseReview[]
  enrollments        Enrollment[]
  orderItems         OrderItem[]
  sections           Section[]
  wishlists          Wishlist[]
  tags               Tag[]          @relation("CourseToTag")

  @@index([instructorId])
  @@index([courseType])
  @@index([level])
  @@index([status])
  @@index([price])
  @@index([discount])
  @@index([createdAt])
  @@index([updatedAt])
}

model Enrollment {
  id        String           @id @default(uuid())
  userId    String
  courseId  String
  status    EnrollmentStatus @default(ENROLLED)
  progress  Float            @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Section {
  id        Int       @id @default(autoincrement())
  title     String
  order     Int
  courseId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  lessons   Lesson[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
  @@index([createdAt])
  @@index([updatedAt])
}

model Lesson {
  id             Int              @id @default(autoincrement())
  title          String
  videoUrl       String
  videoId        String
  duration       Int
  content        String?
  order          Int
  isPreview      Boolean          @default(false)
  sectionId      Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    Int
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  userId      String
  totalAmount Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  orderItems  OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  courseId  String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
}

model Post {
  id                 Int           @id @default(autoincrement())
  title              String
  slug               String        @unique
  content            String
  likes              Int           @default(0)
  dislikes           Int           @default(0)
  views              Int           @default(0)
  authorId           String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  isPublished        Boolean       @default(true)
  thumbnail          String?
  thumbnail_publicID String?
  author             User          @relation(fields: [authorId], references: [id])
  comments           PostComment[]
  tags               Tag[]         @relation("PostToTag")
}

model CourseReview {
  id        Int      @id @default(autoincrement())
  content   String
  rating    Int      @default(5)
  likes     Int      @default(0)
  dislikes  Int      @default(0)
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PostComment {
  id        Int           @id @default(autoincrement())
  content   String
  likes     Int           @default(0)
  dislikes  Int           @default(0)
  userId    String
  postId    Int
  parentId  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    PostComment?  @relation("PostCommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentToComment")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CourseType {
  FREE
  PAID
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}
